{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sankalp-rajeev/ChargePlan/contracts/canonical_graph.schema.json",
  "title": "CanonicalGraph",
  "description": "Directed reduced routing graph for one optimization query. Edges store road distance and driving time only. Edge energy is derived from trip_config, not stored here. A node can charge if and only if charge_rate_kw is non-null, regardless of type. distance_miles must be at least the straight-line distance between the endpoints.",
  "type": "object",
  "additionalProperties": false,
  "required": ["nodes", "edges"],
  "properties": {
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "lat", "lon", "charge_rate_kw"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "description": "Role of the node. Charging ability is charge_rate_kw, not type. An origin may be a home charger.",
          "enum": ["origin", "charger", "destination"]
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "charge_rate_kw": {
          "description": "Effective charging rate in kW. Null means the node cannot charge.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ]
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "distance_miles", "drive_time_minutes"],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "distance_miles": {
          "description": "Road distance in miles. Must be at least the straight-line distance between the endpoints.",
          "type": "number",
          "minimum": 0
        },
        "drive_time_minutes": {
          "description": "Driving time in minutes. Non-negative.",
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
